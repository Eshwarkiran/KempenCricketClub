# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Azure Functions host ---
AzureWebJobsStorage=

# --- Azure SQL ---
SQL_SERVER=<your-server>.database.windows.net
SQL_DATABASE=kcc_dev
SQL_USER=controller
# If the password contains #, ", >, ( or spaces, wrap it in single quotes, e.g. SQL_PASSWORD='p@ss#w0rd"x'
SQL_PASSWORD=<controller-password>
# true = skip TLS cert validation (mirrors DBeaver "Trust Server Certificate"); keep false in production
SQL_TRUST_CERT=false

# --- Client credential accepted by POST /api/token (not a secret) ---
BASIC_AUTH_USER=kccforms
BASIC_AUTH_PASSWORD=<choose-a-strong-value>

# --- JWT signing (IS a secret — long & random, 32+ chars) ---
JWT_SECRET=<long-random-secret-min-32-chars>
JWT_EXPIRES_IN=15m
