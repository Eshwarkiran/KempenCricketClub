# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Azure Functions host ---
AzureWebJobsStorage=

# --- Azure SQL ---
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
# If the password contains #, ", >, ( or spaces, wrap it in single quotes, e.g. SQL_PASSWORD='p@ss#w0rd"x'
SQL_PASSWORD=
# true = skip TLS cert validation (mirrors DBeaver "Trust Server Certificate"); keep false in production
SQL_TRUST_CERT=

# --- Client credential accepted by POST /api/token (not a secret) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- JWT signing (IS a secret — long & random, 32+ chars) ---
JWT_SECRET=
JWT_EXPIRES_IN=

# --- Cloudflare Turnstile (Join / Subscribe / Contact) ---
# Secret key from the Cloudflare Turnstile dashboard. Leave blank to disable
# verification (dev). The matching SITE key (public) goes in
# public/assets/forms.js (TURNSTILE_SITE_KEY).
TURNSTILE_SECRET=

# --- SMTP (confirmation emails for Join / Register) ---
# Leave SMTP_HOST blank to disable email sending (dev). Use SMTP_SECURE=true for port 465.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
