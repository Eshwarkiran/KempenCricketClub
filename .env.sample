# Copy to .env and fill in real values. .env is gitignored — never commit it.

# --- Azure Functions host ---
AzureWebJobsStorage=

# --- Azure SQL ---
SQL_SERVER=
SQL_DATABASE=
SQL_USER=
# If the password contains #, ", >, ( or spaces, wrap it in single quotes, e.g. SQL_PASSWORD='p@ss#w0rd"x'
SQL_PASSWORD=
# true = skip TLS cert validation (mirrors DBeaver "Trust Server Certificate"); keep false in production
SQL_TRUST_CERT=

# --- Client credential accepted by POST /api/token (not a secret) ---
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=

# --- JWT signing (IS a secret — long & random, 32+ chars) ---
JWT_SECRET=
JWT_EXPIRES_IN=

# --- Cloudflare Turnstile (Join / Subscribe / Contact) ---
# Secret key from the Cloudflare Turnstile dashboard. Leave blank to disable
# verification (dev). The matching SITE key (public) goes in
# public/assets/forms.js (TURNSTILE_SITE_KEY).
TURNSTILE_SECRET=

# --- Public site URL (used to build unsubscribe links in emails) ---
# e.g. https://kempencricket.be  or  http://localhost
SITE_URL=

# --- SMTP (confirmation emails for Join / Register) ---
# Leave SMTP_HOST blank to disable email sending (dev). Use SMTP_SECURE=true for port 465.
# SMTP_AUTH_TYPE: "basic" (default, user+password) or "oauth2" (Microsoft 365).
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_AUTH_TYPE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Microsoft 365 OAuth2 (only when SMTP_AUTH_TYPE=oauth2) ---
# Entra app registration with the SMTP.SendAsApp permission. Required because
# M365 is retiring Basic auth / app passwords for SMTP AUTH.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# --- Admin notifications + add-member magic link ---
# ADMIN_EMAIL: where new-signup notifications go (default membership@kempencricket.be)
ADMIN_EMAIL=
MEMBER_LINK_TTL_MIN=1440
