meta {
  name: Add Member
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/api/add-member
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "test@example.com",
    "token": "{{memberLinkToken}}",
    "firstName": "Kiddo",
    "lastName": "Example",
    "dob": "2014-05-01",
    "category": "Junior",
    "gender": "male",
    "medical": "None",
    "turnstileToken": "",
    "lang": "en"
  }
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("success true", function () {
    expect(res.getBody().success).to.equal(true);
  });
}

docs {
  Adds a family member to the account identified by `email`, authenticated by the
  magic-link `token` (see "Add Member — Request Link"). The new member is never
  primary. Duplicate person (same account + name + dob) -> 409. Invalid/expired
  token -> 401.

  Set the `memberLinkToken` env var to a token signed for the same email (see the
  request-link docs for the one-liner).
}
