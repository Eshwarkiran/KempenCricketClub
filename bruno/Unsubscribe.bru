meta {
  name: Unsubscribe
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/unsubscribe
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "test@example.com"
  }
}

tests {
  test("200 OK", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("success true", function () {
    expect(res.getBody().success).to.equal(true);
  });
}

docs {
  Marks a newsletter subscriber as unsubscribed (sets unsubscribed_at). Always
  returns 200 whether or not the address was on the list, to avoid revealing
  which emails exist. Required: `email`.
}
