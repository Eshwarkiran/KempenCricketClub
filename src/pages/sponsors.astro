---
import Layout from '../layouts/Layout.astro';
import main from '../fragments/en/sponsors.main.html?raw';
import scripts from '../fragments/en/sponsors.scripts.html?raw';
---
<Layout lang="en" path="/sponsors" title="Partners &amp; sponsorship | Kempen Cricket Club" description="Back grassroots cricket in the Kempen. Kempen Cricket Club is a young, growing club in Geel \u2014 help us build it and your name grows with us. Flexible local sponsorship." robots="index,follow">
