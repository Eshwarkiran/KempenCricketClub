---
import Layout from '../layouts/Layout.astro';
import main from '../fragments/en/faq.main.html?raw';
import scripts from '../fragments/en/faq.scripts.html?raw';
---
<Layout lang="en" path="/faq" title="Frequently asked questions | Kempen Cricket Club" description="Cricket in the Kempen, explained: do I need experience or kit, what ages can join, what membership costs (\u20ac70 / \u20ac50 / \u20ac25), when and where we train, and more." robots="index,follow">
  <Fragment set:html={main} />
  <Fragment slot="scripts" set:html={scripts} />
</Layout>
