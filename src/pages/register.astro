---
import Layout from '../layouts/Layout.astro';
import main from '../fragments/en/register.main.html?raw';
import scripts from '../fragments/en/register.scripts.html?raw';
---
<Layout lang="en" path="/register" title="Membership registration | Kempen Cricket Club" description="Register for membership of Kempen Cricket Club in Geel. Choose your category, add your details, and we'll confirm your fee and payment by email." robots="noindex">
  <Fragment set:html={main} />
  <Fragment slot="scripts" set:html={scripts} />
</Layout>
