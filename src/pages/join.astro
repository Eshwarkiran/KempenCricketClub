---
import Layout from '../layouts/Layout.astro';
import main from '../fragments/en/join.main.html?raw';
import scripts from '../fragments/en/join.scripts.html?raw';
---
<Layout lang="en" path="/join" title="Join \u2014 three free sessions | Kempen Cricket Club" description="Try cricket in the Kempen with three free sessions, no experience or kit needed. See how joining works, membership fees (Adult \u20ac70, Junior \u20ac50, Supporter \u20ac25) and what to expect." robots="index,follow">
  <Fragment set:html={main} />
  <Fragment slot="scripts" set:html={scripts} />
</Layout>
