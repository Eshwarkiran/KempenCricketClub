---
import Layout from '../layouts/Layout.astro';
import main from '../fragments/en/index.main.html?raw';
import scripts from '../fragments/en/index.scripts.html?raw';
---
<Layout lang="en" path="/" title="Cricket in Geel and the Kempen | Kempen Cricket Club" description="A new home for cricket in the Kempen \u2014 Geel, Mol, Herentals, Laakdal, Meerhout, Tessenderlo. Open to every age and background. Three free tryout sessions, no experience or kit needed." robots="index,follow">
  <Fragment set:html={main} />
  <Fragment slot="scripts" set:html={scripts} />
</Layout>
