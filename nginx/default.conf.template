# Reverse proxy + static host for the Kempen Cricket Club site.
# Serves the built Astro site and forwards /api/* to the Functions container.
#
# This is an nginx TEMPLATE: the base image's entrypoint runs envsubst on it at
# container start, replacing ${API_UPSTREAM} with the env var value (only defined
# env vars are substituted, so $host/$uri/etc. are left untouched).
#   - docker-compose (separate containers):  API_UPSTREAM=api:8080
#   - Azure Container App (same pod):         API_UPSTREAM=localhost:8080

upstream api_upstream {
    server ${API_UPSTREAM};
}

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # gzip for text assets
    gzip on;
    gzip_types text/plain text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # --- API: forward to the Azure Functions container ---
    location /api/ {
        proxy_pass         http://api_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_connect_timeout 30s;
        proxy_read_timeout    30s;
    }

    # --- Static site (Astro: build format 'directory', trailingSlash 'always') ---
    location / {
        try_files $uri $uri/ /404/index.html;
    }

    # Cache fingerprinted build assets aggressively.
    location /_astro/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
}
